# AmanClaw — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env

# Telegram bot token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# LLM API key (for your OpenAI-compatible server)
LLM_API_KEY=

# LLM endpoint (optional — also settable in config.yaml)
# LLM_BASE_URL=http://localhost:8001/v1

# Brave Search API key (optional, for web search skill)
# Get one at https://api.search.brave.com/
# BRAVE_API_KEY=

# Logging (optional)
# LOG_LEVEL=INFO
# LOG_FILE=amanclaw.log
# LOG_FORMAT=text   # or "json" for Docker/structured logging

# Webhook secret (optional, for webhook mode)
# WEBHOOK_SECRET=

# WhatsApp bridge URL (optional, for WhatsApp channel)
# WA_BRIDGE_URL=http://localhost:3001
