{
  "name": "amanclaw-plugin-template",
  "version": "0.1.0",
  "description": "AmanClaw WASM plugin template for AssemblyScript",
  "scripts": {
    "build": "asc assembly/index.ts --target release --exportRuntime --outFile build/plugin.wasm",
    "build:debug": "asc assembly/index.ts --target debug --exportRuntime --outFile build/plugin.debug.wasm",
    "test": "node --test test/plugin.test.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.27"
  }
}
